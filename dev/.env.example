# ============================================================
# TenderRadar — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================

# --- Application ---
APP_NAME=TenderRadar
ENVIRONMENT=development
# Demo mode:
#   false (default) -> scrape REAL tenders from the live portals using the free
#                      Scrapling engine (no API keys). Needs network access to
#                      the portals (run locally, not from a locked-down cloud
#                      box). Run `scrapling install` once for JS portals (GeM).
#   true            -> generate realistic SAMPLE data so the whole app can be
#                      explored offline. NOT real tenders.
DEMO_MODE=false

# --- Database / Cache ---
DATABASE_URL=postgresql+psycopg2://tenderradar:tenderradar@localhost:5432/tenderradar
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --- CORS / Frontend ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Rate limiting (slowapi syntax) ---
RATE_LIMIT=100/minute

# --- Scraping engine (Scrapling — free & open-source, no API keys) ---
# HTTP portals use Chrome TLS impersonation (curl_cffi); JS/anti-bot portals
# (GeM, IREPS) use a stealth headless Chromium. Enable the browser once with:
#     scrapling install        (inside dev/backend, or baked into the Docker image)
# Fetched pages are cached in Redis to avoid hammering the portals.
SCRAPE_CACHE_TTL_SECONDS=1800
RESPECT_ROBOTS_TXT=true
SCRAPE_INTERVAL_HOURS=6
SCRAPE_DELAY_SECONDS=5
PROXY_URL=
ARCHIVE_AFTER_DAYS=180

# --- Email (SMTP takes precedence; SendGrid used if SMTP_HOST empty) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDGRID_API_KEY=
EMAIL_FROM=TenderRadar <noreply@tenderradar.example>

# --- AI summary (optional; stubbed when no key present) ---
AI_PROVIDER=stub            # stub | openai | groq
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Object storage for raw scraped HTML (local dir by default) ---
STORAGE_DIR=storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Scheduler ---
SCHEDULER_ENABLED=true

# --- Seeded superadmin ---
ADMIN_EMAIL=admin@tenderradar.example
ADMIN_PASSWORD=Admin@12345

# --- Tier limits ---
FREE_TIER_KEYWORD_LIMIT=5

# --- docker-compose only ---
POSTGRES_USER=tenderradar
POSTGRES_PASSWORD=tenderradar
POSTGRES_DB=tenderradar
